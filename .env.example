# Скопіюй у .env і заповни. .env і credentials/ — у .gitignore, у git не комітяться.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

GOOGLE_CREDENTIALS_PATH=credentials/credentials.json
GOOGLE_TOKEN_PATH=credentials/token.json

# Push-сповіщення наприкінці кожного запуску (безумовно, як і в чат-версії).
# 1. Постав застосунок ntfy (https://ntfy.sh, iOS/Android) або відкрий
#    https://ntfy.sh/<будь-яка-унікальна-назва-теми> в браузері.
# 2. Впиши ту саму назву теми нижче — має бути важко вгадати (це публічний
#    pub/sub без автентифікації, будь-хто, хто знає назву теми, побачить
#    повідомлення).
PUSH_NTFY_TOPIC=
PUSH_NTFY_SERVER=https://ntfy.sh

# Freelancehunt API v2 (Крок 1.2) — необов'язково, але рекомендовано:
# стабільний JSON замість HTML-скрапінгу, без HTTP 403.
# Токен: freelancehunt.com -> Налаштування профілю -> API.
# Порожньо -> фолбек на HTML-скрапінг категорій.
FREELANCEHUNT_API_TOKEN=
